PORT=5000
NODE_ENV=development

# PostgreSQL connection (Render will give you this as a single URL)
DATABASE_URL=postgresql://username:password@localhost:5432/school_management
PGSSL=false

# JWT - generate a real random string, e.g: openssl rand -base64 48
# NEVER paste this whole .env.example file as the value - only the secret string itself
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL for CORS (your Vercel deployment)
CLIENT_URL=http://localhost:5173
